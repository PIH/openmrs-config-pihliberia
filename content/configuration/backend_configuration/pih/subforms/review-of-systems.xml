                        </template>
                        <render acID="141600" name="Shortness of breath"/>
                        <render acID="143264" name="Cough"/>
                        <render acID="5957"   name="Productive cough"/>
                        <render acID="138905" name="Hemoptysis"/>
                        <render acID="5209"   name="Wheezing"/>
                        <render acID="130051" name="Pleuritic chest pain"/>
