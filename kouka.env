export OPENMRS_IMAGE_NAME=partnersinhealth/pihliberia-emr
# All four site profiles share almost all configuration, so this reuses the shared
# harper-demo seed image rather than maintaining a separate one per site. If kouka's
# data ever needs to diverge enough to warrant its own seed, point this at
# partnersinhealth/pihliberia-emr-seed-kouka once a build-seeded-images.yml job for it exists.
export SEED_IMAGE_NAME=partnersinhealth/pihliberia-emr-seed-harper-demo
export OPENMRS_PIH_CONFIG=liberia,liberia-harper,liberia-harper-kouka
export DISTRO_SOURCE_DIR="$(pwd)"
